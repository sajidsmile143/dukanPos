# Dukaan POS Environment Configuration
# Copy this file to .env.local to configure real Supabase & FBR settings

NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# FBR Fiscal POS Configuration
FBR_SANDBOX_API_URL=https://bonusedal.fbr.gov.pk/api/Live/PostIntegrationData
FBR_POS_ID=123456
FBR_BEARER_TOKEN=fbr-sandbox-bearer-token-12345

# Store Default Metadata
NEXT_PUBLIC_STORE_NAME="Dukaan Retail & Pharmacy"
NEXT_PUBLIC_STORE_PHONE="+92 300 1234567"
NEXT_PUBLIC_STORE_ADDRESS="Shop #12, Commercial Area, Main Boulevard, Lahore"
NEXT_PUBLIC_DEFAULT_TAX_RATE=18.0
